PORT=3001
HOST=127.0.0.1
# Optional: enables semantic image analysis and speech transcription.
# Without a key, Viralify runs its local, explainable content assessment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional override for the bundled FFmpeg executable.
FFMPEG_PATH=
